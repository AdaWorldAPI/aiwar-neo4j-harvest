        "#| label: fig-graphic\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from IPython.display import display\n",
        "import ipywidgets as widgets\n",
        "\n",
        "# pd.read_json('aiwar.json')\n",
        "tips = sns.load_dataset(\"tips\")\n",
        "# sns.load_dataset(data)\n",
        "sns.set_style(\"whitegrid\")\n",
        "# sns.set_theme()\n",
        "\n",
        "g = sns.lmplot(x=\"tip\", y=\"total_bill\", data=tips, aspect=2)\n",
        "# r = sns.relplot(x=\"total_bill\", y=\"tip\", col=\"time\", hue=\"smoker\", style=\"smoker\", size=\"size\")\n",
        "\n",
        "g = g.set_axis_labels(\"Tip\", \"Total Bill\").set(xlim=(0,10),ylim=(0,100))\n",
        "\n",
        "plt.title(\"Chart\")\n",
        "\n",
        "plt.show(g)\n"
      ],
      "id": "fig-graphic",
      "execution_count": null,
      "outputs": []
